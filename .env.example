# ──────────────────────────────────────────────────────────────
# Call-Booking Platform — environment template
# Copy to .env:  cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ── Database-per-service ────────────────────────────────────────
# Each service owns a SEPARATE PostgreSQL instance with its OWN
# user/password. Nothing is shared — a credential leak or load spike
# in one service cannot touch another's data. To move a service to a
# dedicated DB server, just point its *_POSTGRES_HOST at the new host.

# auth-service database
AUTH_POSTGRES_HOST=auth-postgres
AUTH_POSTGRES_USER=auth_user
AUTH_POSTGRES_PASSWORD=auth_pass
AUTH_POSTGRES_DB=auth_db
AUTH_POSTGRES_HOST_PORT=5433

# booking-service database
BOOKING_POSTGRES_HOST=booking-postgres
BOOKING_POSTGRES_USER=booking_user
BOOKING_POSTGRES_PASSWORD=booking_pass
BOOKING_POSTGRES_DB=booking_db
BOOKING_POSTGRES_HOST_PORT=5434

# calendar-service database
CALENDAR_POSTGRES_HOST=calendar-postgres
CALENDAR_POSTGRES_USER=calendar_user
CALENDAR_POSTGRES_PASSWORD=calendar_pass
CALENDAR_POSTGRES_DB=calendar_db
CALENDAR_POSTGRES_HOST_PORT=5435

# ── Redis (shared backbone) ─────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
# booking-service distributed lock DB
REDIS_LOCK_DB=0
# notification-service pub/sub channel + per-user history DB
REDIS_NOTIFICATIONS_DB=1

# ── Kafka (shared backbone) ─────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_HOST_PORT=9092
KAFKA_TOPIC_BOOKING_CREATED=booking.created
KAFKA_TOPIC_BOOKING_CANCELLED=booking.cancelled
KAFKA_TOPIC_BOOKING_UPDATED=booking.updated

# ── ClickHouse (analytics OLAP store) ───────────────────────────
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_HTTP_HOST_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=analytics

# ── JWT (asymmetric RS256) ──────────────────────────────────────
# Keys are generated by scripts/gen-jwt-keys.sh into infra/jwt/ and
# mounted read-only into containers (paths are set in compose):
#   private.pem -> auth-service only (signs tokens)
#   public.pem  -> every verifier (booking/calendar/notification — checks signatures)
# NOTE: the algorithm is hard-coded to RS256 in each service's config.py (it is
# bound to the RSA keys) and is deliberately NOT an env var — a stray
# JWT_ALGORITHM in your shell can never flip it to HS256.
JWT_EXPIRE_MINUTES=60

# ── Service ports (host-exposed for local dev) ──────────────────
AUTH_PORT=8001
BOOKING_PORT=8002
CALENDAR_PORT=8003
ANALYTICS_PORT=8005
GATEWAY_PORT=8080
FRONTEND_PORT=5173

# ── Google Calendar OAuth (calendar-service) ────────────────────
# Create an OAuth 2.0 "Web application" client in Google Cloud Console
# (APIs & Services → Credentials) with the Google Calendar API enabled.
# The redirect URI MUST be added verbatim to the client's "Authorized
# redirect URIs" — it points at the gateway, which proxies /api/calendar/
# to calendar-service.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/calendar/google/callback
# Where calendar-service resolves participant email/name from.
AUTH_SERVICE_URL=http://auth-service:8001
# Public origin of the SPA (callback fallback redirect).
FRONTEND_URL=http://localhost:8080

# ── Frontend ────────────────────────────────────────────────────
# The SPA prefixes API calls with this base and hits the same origin
# (the gateway). The gateway routes /api/auth /api/booking /api/analytics
# /api/calendar to the services (stripping /api) and everything else to
# the frontend. Keep it as /api unless you also change nginx.conf.
VITE_API_BASE=/api
